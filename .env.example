# Which persona to load (path to YAML in personas/)
PERSONA=personas/sample.yaml

# Where to store SQLite session DB
DB_PATH=./data/voice_agent.db

# Provider keys — only required for providers actually used by the loaded persona
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
TELEGRAM_BOT_TOKEN=

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
